{
  "name": "scoresmith",
  "version": "0.2.100",
  "description": "ScoreSmith - a browser-based AI-assisted sheet-music composition app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "icons": "bash scripts/make-icons.sh",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "localize": "SCRIPT=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/localize_batch.cjs -o $SCRIPT && node $SCRIPT ./public/locales https://api.whisperly.dev/api/v1/translate/jie9cytr/moosiac --word-limit 40 && rm -f $SCRIPT && prettier . --write",
    "localize_local": "SCRIPT=$(mktemp) && curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/localize_batch.cjs -o $SCRIPT && node $SCRIPT ./public/locales http://localhost:8021/api/v1/translate/jie9cytr/moosiac --word-limit 40 && rm -f $SCRIPT && prettier . --write",
    "localized": "node scripts/localization_verify.cjs",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@revenuecat/purchases-js": "^1.52.3",
    "@sudobility/auth-components": "^1.0.11",
    "@sudobility/auth_lib": "^0.0.96",
    "@sudobility/building_blocks": "^0.0.303",
    "@sudobility/components": "^5.3.19",
    "@sudobility/consumables_client": "^0.0.24",
    "@sudobility/consumables_pages": "^0.0.51",
    "@sudobility/design": "^1.1.54",
    "@sudobility/di": "^1.5.65",
    "@sudobility/di_web": "^0.1.233",
    "@sudobility/music_client": "^0.4.60",
    "@sudobility/music_editing": "^0.0.17",
    "@sudobility/music_io": "^0.9.35",
    "@sudobility/music_lib": "^1.9.34",
    "@sudobility/music_player": "^0.1.24",
    "@sudobility/music_types": "^0.13.23",
    "@sudobility/seo_lib": "^0.0.38",
    "@sudobility/types": "^1.9.67",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.0.0",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "js-synthesizer": "^1.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.2.1",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sudobility/music_codecs": "^0.2.24",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fake-indexeddb": "^6.2.5",
    "htmlparser2": "^12.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.41",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
