# ScoreSmith web app environment. Vite exposes only VITE_*.

# Branding (never hardcode the product name in components — src/config/constants.ts)
VITE_APP_NAME=ScoreSmith
VITE_APP_DOMAIN=scoresmith.app
VITE_COMPANY_NAME=Sudobility
VITE_SUPPORT_EMAIL=support@sudobility.com

# music_api base URL
VITE_API_URL=http://localhost:8032

# Entity/workspace management UI is opt-in. Set to true to show the workspace
# selector and Workspaces, Members, and Invitations dashboard sections.
VITE_SHOW_ENTITIES=false

# Firebase web config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ---- Credits store (RevenueCat) --------------------------------------------
# Without these the credits page shows a balance and nothing to buy: the store
# has no offering to read, so `useConsumableProducts('credits')` returns an
# empty list. Non-production builds always use the sandbox key, so a developer
# or an e2e run cannot reach a live payment (see config/initialize.ts).
#
# The packages themselves — their price, e.g. $1 — are configured in RevenueCat
# under the `credits` offering. How many credits each one grants is decided by
# the *server*, not the store: set CREDIT_PRODUCTS in music_api, e.g.
#   CREDIT_PRODUCTS=scoresmith_credits_1:100
# for the intended rate of 100 credits per dollar. music_api refuses a purchase
# for a product it has no entry for, rather than inventing an amount.
VITE_REVENUECAT_API_KEY=
VITE_REVENUECAT_API_KEY_SANDBOX=
# true selects the sandbox key; false selects the production key.
VITE_DEV_MODE=false

# e2e-only auth shim — leave disabled for normal use (Playwright sets these itself)
VITE_E2E=0
VITE_E2E_TOKEN=

# -----------------------------------------------------------------------------
# FIREBASE CHINA PROXY
# -----------------------------------------------------------------------------
# Reverse proxy that keeps Firebase Auth, Remote Config and Analytics working
# for mainland-China users. Leave blank to use Firebase directly.
VITE_FIREBASE_PROXY=https://firebaseproxy.sudobility.com
